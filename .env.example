# Google OAuth2 Credentials (Google Cloud Console -> People API enabled)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: Provide a refresh token or access token directly.
# If omitted, run `node google-contacts-mcp.mjs --auth` once to authenticate interactively
# and store tokens at ~/.config/google-contacts-mcp/tokens.json
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=

# Optional: Custom path to OAuth client credentials JSON or saved token file
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKENS_PATH=

# Optional: Vision API keys for direct server-side OCR/extraction from PNG/JPG
# (Not required when Claude, ChatGPT, or Gemini extracts image fields directly or via MCP Sampling)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Run as Streamable HTTP / SSE MCP server (for ChatGPT Connectors / remote clients)
# Default mode is stdio
MCP_TRANSPORT=stdio
PORT=3000
