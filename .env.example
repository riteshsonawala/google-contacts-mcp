# Default mode is "browser" (automates https://contacts.google.com via Playwright or Chrome CDP).
# Zero Client ID or Client Secret required!
GOOGLE_CONTACTS_BACKEND=browser

# Optional: Custom persistent Chrome profile directory or Chrome executable path
# GOOGLE_CONTACTS_PROFILE_DIR=~/.config/google-contacts-mcp/chrome-profile
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Optional: Vision API keys for direct server-side OCR/extraction from PNG/JPG
# (Not required when Claude, ChatGPT, or Gemini extracts image fields directly or via MCP Sampling)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Secondary Mode: Google People API (only used if GOOGLE_CONTACTS_BACKEND=api)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
